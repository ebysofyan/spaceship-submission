{
  "name": "logistics-analytics",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --watch apps/api/src/server.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun apps/api/src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
