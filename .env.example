AI_API_KEY=
AI_BASE_URL=https://ai.sumopod.com/v1
AI_MODEL=gpt-6-luna
# Sent as reasoning_effort. gpt-6-luna needs "none" for tool calls; leave empty to not send it.
AI_REASONING_EFFORT=none
# LLM calls per UTC day, then keyword matching. Counter is per process; resets on restart.
AI_DAILY_LIMIT=500
PORT=3000
# Optional: defaults to data/mock_logistics_data.csv
DATA_PATH=
